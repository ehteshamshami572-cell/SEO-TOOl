# Database Connection
# For production PostgreSQL:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/shopify_seo?schema=public"
# For zero-dependency local development (SQLite):
# DATABASE_URL="file:./dev.db"

# Redis Connection (BullMQ)
REDIS_URL="redis://localhost:6379"

# Google PageSpeed Insights API Key (Optional for basic audits, required for Core Web Vitals)
# Get a free key at https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=""

# Crawler Configuration & Safeguards
CRAWLER_USER_AGENT="Mozilla/5.0 (compatible; ShopifySeoAuditorBot/1.0; +https://example.com/bot)"
MAX_PAGES_PER_AUDIT=25
MAX_REDIRECT_HOPS=5
REQUEST_TIMEOUT_MS=10000
MAX_RESPONSE_SIZE_BYTES=5242880
RATE_LIMIT_DELAY_MS=250

# Web Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
